        // 448 - Receiver API Key and amount are required
        if (!receiverApiKey || !amount) {
            return res.status(448).json({
                status: 'failed',
                message: 'Receiver API Key and amount are required',
                data: []
            });
        }

        // 449 - Minimum request amount is ₹1
        if (amount < 1) {
            return res.status(449).json({
                status: 'failed',
                message: 'Minimum request amount is ₹1',
                data: []
            });
        }

        // 450 - Invalid receiver API Key format
        if (!receiverApiKey || receiverApiKey.length !== 10 || !/^[A-Z0-9]+$/.test(receiverApiKey)) {
            return res.status(450).json({
                status: 'failed',
                message: 'Invalid receiver API Key format',
                data: []
            });
        }

        // 451 - Receiver not found
        const receiverResult = await validateReceiverApiKey(receiverApiKey);
        if (receiverResult.status === 'failed') {
            return res.status(451).json({
                status: 'failed',
                message: receiverResult.message,
                data: []
            });
        }
