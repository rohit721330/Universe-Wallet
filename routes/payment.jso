<b>───────────────</b>

<b>👤 Dᴇᴀʀ ${receiver.fullName},</b> Yᴏᴜ Hᴀᴠᴇ Rᴇᴄᴇɪᴠᴇᴅ A Pᴀʏᴍᴇɴᴛ Iɴ Yᴏᴜʀ Wᴀʟʟᴇᴛ.

💰 <b>Aᴍᴏᴜɴᴛ:</b> ₹${paymentAmount}
👤 <b>Fʀᴏᴍ:</b> ${sender.fullName}
💳 <b>Nᴇᴡ Bᴀʟᴀɴᴄᴇ:</b> ₹${receiver.balance}
🆔 <b>Tʀᴀɴꜱᴀᴄᴛɪᴏɴ Iᴅ:</b> ${txn_Id}
📝 <b>Cᴏᴍᴍᴇɴᴛ:</b> ${comment || 'N/A'}
📅 <code>${new Date().toLocaleString()}</code>

───────────────────────
✅ Aᴍᴏᴜɴᴛ Cʀᴇᴅɪᴛᴇᴅ Tᴏ Yᴏᴜʀ Wᴀʟʟᴇᴛ Sᴜᴄᴄᴇꜱꜱꜰᴜʟʟʏ.
───────────────────────`;
            await sendTelegramMessage(receiver.telegramId, receiverMessage);
        }

        // ============================================
        // 200 - Payment successful
        // ============================================
        res.status(200).json({
            status: 'success',
            message: 'Payment successful',
            data: {
                transaction_id: txn_Id,
                amount: paymentAmount,
                sender: {
                    name: sender.fullName,
                    number: sender.mobile
                },
                receiver: {
                    name: receiver.fullName,
                    number: receiver.mobile
                },
                comment: comment || 'Paid',
                timestamp: new Date().toLocaleString('en-IN', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit',
                    hour12: false
                }).replace(/\//g, '-')
            }
        });

    } catch (error) {
        await session.abortTransaction();
        console.error('Payment Error:', error);
        
        // 434 - Transaction ID conflict
        if (error.code === 11000) {
            return res.status(434).json({
                status: 'failed',
                message: 'Transaction ID conflict. Please retry',
                data: []
            });
        }
        
        // 500 - Failed to process payment
        res.status(500).json({
            status: 'failed',
            message: 'Failed to process payment',
            data: []
        });
    } finally {
        session.endSession();
    }
});

// ============================================
// MAKE PAYMENT (AUTHENTICATED - Regular TXN)
// ============================================
router.post('/make', auth, async (req, res) => {
    const session = await mongoose.startSession();
    session.startTransaction();
    
    try {
        const { receiverApiKey, amount, note = '', txnId } = req.body;
        const sender = req.user;

        console.log('💳 Payment Request From:', sender._id);

        // 435 - Receiver API Key and amount are required
        if (!receiverApiKey || !amount) {
            await session.abortTransaction();
            return res.status(435).json({
                status: 'failed',
                message: 'Receiver API Key and amount are required',
                data: []
            });
        }

        // 436 - Minimum payment amount is ₹1
        if (amount < 1) {
            await session.abortTransaction();
            return res.status(436).json({
                status: 'failed',
                message: 'Minimum payment amount is ₹1',
                data: []
            });
        }

        // 437 - Maximum payment amount is ₹5,000
        if (amount > 5000) {
            await session.abortTransaction();
            return res.status(437).json({
                status: 'failed',
                message: 'Maximum payment amount is ₹5,000',
                data: []
            });
        }

        // 438 - Cannot pay yourself
        if (sender.apiKey === receiverApiKey) {
            await session.abortTransaction();
            return res.status(438).json({
                status: 'failed',
                message: 'You cannot pay yourself',
                data: []
            });
        }

        // 439 - Invalid receiver API Key format
        if (!receiverApiKey || receiverApiKey.length !== 10 || !/^[A-Z0-9]+$/.test(receiverApiKey)) {
            await session.abortTransaction();
            return res.status(439).json({
                status: 'failed',
                message: 'Invalid receiver API Key format',
                data: []
            });
        }

        // 440 - Receiver not found
        const receiverResult = await validateReceiverApiKey(receiverApiKey);
        if (receiverResult.status === 'failed') {
            await session.abortTransaction();
            return res.status(440).json({
                status: 'failed',
                message: receiverResult.message,
                data: []
            });
        }
        const receiver = receiverResult.user;

        // 441 - Insufficient balance
        if (sender.balance < amount) {
            await session.abortTransaction();
            return res.status(441).json({
                status: 'failed',
                message: 'Insufficient balance',
                data: { balance: sender.balance }
            });
        }

        // 442 - Receiver account is blocked
        if (receiver.isBlocked) {
            await session.abortTransaction();
            return res.status(442).json({
                status: 'failed',
                message: 'Receiver account is blocked',
                data: []
            });
        }

        const txn_Id = generateTxnId(txnId, false);

        const senderOldBalance = sender.balance;
        const receiverOldBalance = receiver.balance;
        
        sender.balance = senderOldBalance - amount;
        receiver.balance = receiverOldBalance + amount;

        await sender.save({ session });
        await receiver.save({ session });

        const senderTransaction = new Transaction({
            user_id: sender._id,
            sender_id: sender._id,
            receiver_id: receiver._id,
            amount: amount,
            type: 'transfer',
            status: 'success',
            remark: note || `Payment to ${receiver.fullName}`,
            description: note || `Payment to ${receiver.fullName}`,
            tx_id: txn_Id,
            metadata: {
                transactionType: 'payment_sent',
                senderOldBalance,
                receiverOldBalance,
                senderName: sender.fullName,
                receiverName: receiver.fullName,
                note: note || '',
                apiEndpoint: 'POST'
            }
        });
        await senderTransaction.save({ session });

        const receiverTransaction = new Transaction({
            user_id: receiver._id,
            sender_id: sender._id,
            receiver_id: receiver._id,
            amount: amount,
            type: 'transfer',
            status: 'success',
            remark: note || `Payment from ${sender.fullName}`,
            description: note || `Payment from ${sender.fullName}`,
            tx_id: txn_Id,
            metadata: {
                transactionType: 'payment_received',
                senderOldBalance,
                receiverOldBalance,
                senderName: sender.fullName,
                receiverName: receiver.fullName,
                note: note || '',
                apiEndpoint: 'POST'
            }
        });
        await receiverTransaction.save({ session });

        await session.commitTransaction();
        console.log('✅ Payment Successful:', txn_Id);

        // ===== BOT MESSAGES - STYLISH (For Telegram Users) =====
        if (sender.telegramId) {
            const senderMessage = 
`<b>───────────────</b>
<b>💸 Aᴩɪ Pᴀʏᴍᴇɴᴛ Sᴇɴᴛ</b>
<b>───────────────</b>

<b>👤 Dᴇᴀʀ ${sender.fullName},</b> Yᴏᴜʀ Pᴀʏᴍᴇɴᴛ Hᴀꜱ Bᴇᴇɴ Pʀᴏᴄᴇꜱꜱᴇᴅ Sᴜᴄᴄᴇꜱꜱꜰᴜʟʟʏ.

💰 <b>Aᴍᴏᴜɴᴛ:</b> ₹${amount}
👤 <b>Tᴏ:</b> ${receiver.fullName}
💳 <b>Nᴇᴡ Bᴀʟᴀɴᴄᴇ:</b> ₹${sender.balance}
🆔 <b>Tʀᴀɴꜱᴀᴄᴛɪᴏɴ Iᴅ:</b> ${txn_Id}
📝 <b>Nᴏᴛᴇ:</b> ${note || 'N/A'}
📅 <code>${new Date().toLocaleString()}</code>

───────────────────────
⚠️ Iꜰ Tʜɪꜱ Wᴀꜱɴ'ᴛ Yᴏᴜ, Pʟᴇᴀꜱᴇ Cᴏɴᴛᴀᴄᴛ Sᴜᴘᴘᴏʀᴛ Iᴍᴍᴇᴅɪᴀᴛᴇʟʏ.
───────────────────────`;
            await sendTelegramMessage(sender.telegramId, senderMessage);
        }

        if (receiver.telegramId) {
            const receiverMessage = 
`<b>───────────────</b>
<b>💰 Aᴩɪ Pᴀʏᴍᴇɴᴛ Rᴇᴄᴇɪᴠᴇᴅ</b>
<b>───────────────</b>

<b>👤 Dᴇᴀʀ ${receiver.fullName},</b> Yᴏᴜ Hᴀᴠᴇ Rᴇᴄᴇɪᴠᴇᴅ A Pᴀʏᴍᴇɴᴛ Iɴ Yᴏᴜʀ Wᴀʟʟᴇᴛ.

💰 <b>Aᴍᴏᴜɴᴛ:</b> ₹${amount}
👤 <b>Fʀᴏᴍ:</b> ${sender.fullName}
💳 <b>Nᴇᴡ Bᴀʟᴀɴᴄᴇ:</b> ₹${receiver.balance}
🆔 <b>Tʀᴀɴꜱᴀᴄᴛɪᴏɴ Iᴅ:</b> ${txn_Id}
📝 <b>Nᴏᴛᴇ:</b> ${note || 'N/A'}
📅 <code>${new Date().toLocaleString()}</code>

───────────────────────
✅ Aᴍᴏᴜɴᴛ Cʀᴇᴅɪᴛᴇᴅ Tᴏ Yᴏᴜʀ Wᴀʟʟᴇᴛ Sᴜᴄᴄᴇꜱꜱꜰᴜʟʟʏ.
───────────────────────`;
            await sendTelegramMessage(receiver.telegramId, receiverMessage);
        }

        // ============================================
        // 200 - Payment sent successfully
        // ============================================
        res.status(200).json({
            status: 'success',
            message: 'Payment sent successfully',
            data: {
                transaction_id: txn_Id,
                amount: amount,
                sender: {
                    name: sender.fullName,
                    number: sender.mobile
                },
                receiver: {
                    name: receiver.fullName,
                    number: receiver.mobile
                },
                comment: note || 'Paid',
                timestamp: new Date().toLocaleString('en-IN', {
                    day: '2-digit',
                    month: '2-digit',
                    year: 'numeric',
                    hour: '2-digit',
                    minute: '2-digit',
                    second: '2-digit',
                    hour12: false
                }).replace(/\//g, '-')
            },
            newBalance: sender.balance
        });

    } catch (error) {
        await session.abortTransaction();
        console.error('Payment Error:', error);
        
        // 443 - Transaction ID conflict
        if (error.code === 11000) {
            return res.status(443).json({
                status: 'failed',
                message: 'Transaction ID conflict. Please retry',
                data: []
            });
        }
        
        // 500 - Failed to process payment
        res.status(500).json({
            status: 'failed',
            message: 'Failed to process payment',
            data: []
        });
    } finally {
        session.endSession();
    }
});

// ============================================
// GET USER BY API KEY (For Payment Lookup)
// ============================================
router.post('/lookup', auth, async (req, res) => {
    try {
        const { apiKey } = req.body;
        const user = req.user;

        // 444 - API Key required
        if (!apiKey) {
            return res.status(444).json({
                status: 'failed',
                message: 'API Key required',
                data: []
            });
        }

        // 445 - Cannot lookup yourself
        if (user.apiKey === apiKey) {
            return res.status(445).json({
                status: 'failed',
                message: 'You cannot lookup yourself',
                data: []
            });
        }

        // 446 - User not found
        const receiver = await User.findOne({ apiKey }).select('fullName mobile walletId');
        
        if (!receiver) {
            return res.status(446).json({
                status: 'failed',
                message: 'User not found',
                data: []
            });
        }

        // ============================================
        // 200 - User found
        // ============================================
        res.status(200).json({
            status: 'success',
            message: 'User found',
            data: {
                name: receiver.fullName,
                number: receiver.mobile,
                walletId: receiver.walletId
            }
        });

    } catch (error) {
        console.error('Lookup Error:', error);
        res.status(500).json({
            status: 'failed',
            message: 'Failed to lookup user',
            data: []
        });
    }
});

// ============================================
// GET PAYMENT HISTORY
// ============================================
router.get('/history', auth, async (req, res) => {
    try {
        const user = req.user;
        const { page = 1, limit = 20 } = req.query;

        const skip = (parseInt(page) - 1) * parseInt(limit);

        const transactions = await Transaction.find({
            $or: [
                { sender_id: user._id },
                { receiver_id: user._id }
            ]
        })
        .sort({ tx_time: -1 })
        .skip(skip)
        .limit(parseInt(limit))
        .populate('sender_id', 'fullName mobile')
        .populate('receiver_id', 'fullName mobile');

        const total = await Transaction.countDocuments({
            $or: [
                { sender_id: user._id },
                { receiver_id: user._id }
            ]
        });

        const transformedTransactions = transactions.map(txn => {
            const txnObj = txn.toObject();
            if (txn.sender_id && txn.sender_id._id.toString() === user._id.toString()) {
                txnObj.userRole = 'sender';
                txnObj.transactionType = 'payment_sent';
            } else if (txn.receiver_id && txn.receiver_id._id.toString() === user._id.toString()) {
                txnObj.userRole = 'receiver';
                txnObj.transactionType = 'payment_received';
            }
            if (txn.metadata && txn.metadata.transactionType) {
                txnObj.transactionType = txn.metadata.transactionType;
            }
            delete txnObj.metadata?.senderApiKey;
            delete txnObj.metadata?.receiverApiKey;
            return txnObj;
        });

        // ============================================
        // 200 - Transactions fetched successfully
        // ============================================
        res.status(200).json({
            status: 'success',
            message: 'Transactions fetched successfully',
            data: {
                transactions: transformedTransactions,
                pagination: {
                    currentPage: parseInt(page),
                    totalPages: Math.ceil(total / parseInt(limit)),
                    totalTransactions: total
                }
            }
        });

    } catch (error) {
        console.error('Get Payment History Error:', error);
        res.status(500).json({
            status: 'failed',
            message: 'Failed to fetch payment history',
            data: []
        });
    }
});

// ============================================
// GET PAYMENT DETAILS BY TRANSACTION ID
// ============================================
router.get('/:txnId', auth, async (req, res) => {
    try {
        const { txnId } = req.params;
        const user = req.user;

        // 447 - Transaction not found
        const transaction = await Transaction.findOne({
            tx_id: txnId,
            $or: [
                { sender_id: user._id },
                { receiver_id: user._id }
            ]
        })
        .populate('sender_id', 'fullName mobile walletId')
        .populate('receiver_id', 'fullName mobile walletId');

        if (!transaction) {
            return res.status(447).json({
                status: 'failed',
                message: 'Transaction not found',
                data: []
            });
        }

        const txnObj = transaction.toObject();
        if (txnObj.sender_id && txnObj.sender_id._id.toString() === user._id.toString()) {
            txnObj.userRole = 'sender';
            txnObj.transactionType = 'payment_sent';
        } else if (txnObj.receiver_id && txnObj.receiver_id._id.toString() === user._id.toString()) {
            txnObj.userRole = 'receiver';
            txnObj.transactionType = 'payment_received';
        }
        if (txnObj.metadata && txnObj.metadata.transactionType) {
            txnObj.transactionType = txnObj.metadata.transactionType;
        }
        delete txnObj.metadata?.senderApiKey;
        delete txnObj.metadata?.receiverApiKey;

        // ============================================
        // 200 - Transaction found
        // ============================================
        res.status(200).json({
            status: 'success',
            message: 'Transaction found',
            data: {
                transaction: txnObj
            }
        });

    } catch (error) {
        console.error('Get Transaction Error:', error);
        res.status(500).json({
            status: 'failed',
            message: 'Failed to fetch transaction',
            data: []
        });
    }
});

