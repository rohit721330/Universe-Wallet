// ============================================
// VALIDATE API KEY (Internal)
// ============================================
router.get('/validate-key/:apiKey', async (req, res) => {
    try {
        const { apiKey } = req.params;
        
        // 455 - Invalid API Key format
        if (!apiKey || apiKey.length !== 10 || !/^[A-Z0-9]+$/.test(apiKey)) {
            return res.status(455).json({ 
                status: 'failed', 
                message: 'Invalid API Key format',
                data: []
            });
        }
        
        const user = await User.findOne({ apiKey }).select('fullName walletId mobile balance apiKeyActive');
        
        // 456 - Invalid API Key
        if (!user) {
            return res.status(456).json({ 
                status: 'failed', 
                message: 'Invalid API Key',
                data: []
            });
        }
        
        // 457 - API Key is disabled
        if (user.apiKeyActive === false) {
            return res.status(457).json({ 
                status: 'failed', 
                message: 'API Key is disabled',
                data: []
            });
        }
        
        // ============================================
        // 200 - API Key validated
        // ============================================
        res.status(200).json({
            status: 'success',
            message: 'API Key validated',
            data: {
                name: user.fullName,
                walletId: user.walletId,
                number: user.mobile,
                balance: user.balance
            }
        });
    } catch (error) {
        console.error('Validate API Key Error:', error);
        res.status(500).json({ 
            status: 'failed', 
            message: 'Server error',
            data: []
        });
    }
});

module.exports = router;
